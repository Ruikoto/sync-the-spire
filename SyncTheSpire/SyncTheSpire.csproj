<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- skip ICU data; saves ~8 MB on self-contained. audited safe: no CultureInfo.Current*,
         no StringComparison.Current*, no implicit culture parse/format. all DateTime/number
         formatting uses explicit invariant patterns. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- drop satellite resource DLLs for languages we don't ship. these only affect .NET / WebView2
         framework error messages (UI text comes from our own i18n.js, not framework resources).
         saves ~9 MB raw, a few MB inside the MSIX (resource files compress well, but they're unique
         enough that LZX can't dedup them across runtimes). -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationIcon>assets\icon.ico</ApplicationIcon>
    <!-- local builds get nightly-YYYYMMDD-HHmmss, CI overrides via -p:InformationalVersion=v1.0.0 -->
    <InformationalVersion>nightly-$([System.DateTime]::UtcNow.ToString('yyyyMMdd-HHmmss'))</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Version>1.0.0</Version>
    <Authors>Ruikoto</Authors>
    <Product>Sync the Spire</Product>
    <Description>Git-based mod synchronizer for Slay the Spire 2</Description>
    <RepositoryUrl>https://github.com/Ruikoto/sync-the-spire</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright (c) 2025-2026 Ruikoto</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3856.49" />
    <PackageReference Include="LibGit2Sharp" Version="0.31.0" />
    <PackageReference Include="SharpCompress" Version="0.38.0" />
  </ItemGroup>

  <!-- expose internal members to the test project. Plain string overload keeps the
       project file deterministic and avoids new AssemblyInfo.cs. -->
  <ItemGroup>
    <InternalsVisibleTo Include="SyncTheSpire.Tests" />
  </ItemGroup>

  <!-- embed wwwroot as content -->
  <ItemGroup>
    <Content Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets\icon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets\ModProfileBypass\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets\sts2.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets\sv.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets\mc.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- mingit + git-lfs ship as a single embedded zip resource. MinGitExtractor unpacks
         it on first run to %LocalAppData%\SyncTheSpire\MinGit\, with SHA256-sentinel skip
         on subsequent launches. one path for both zip + MSIX builds. The bundle.zip is
         tracked in git; refresh it via tools\update-mingit-bundle.ps1 (maintainer-only). -->
    <EmbeddedResource Include="tools\mingit-bundle.zip" LogicalName="MinGitBundle.zip" />
  </ItemGroup>

  <!-- fail fast if the bundle is missing — pointing the maintainer at the regen tool is the
       right answer. Skipped during design-time builds so IntelliSense in a fresh clone
       doesn't get red-squiggled. -->
  <Target Name="EnsureMinGitBundled" BeforeTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)tools\mingit-bundle.zip')"
           Text="mingit-bundle.zip 缺失。Maintainer 需运行 'pwsh $(MSBuildThisFileDirectory)tools\update-mingit-bundle.ps1' 重新生成并提交。" />
  </Target>

</Project>
